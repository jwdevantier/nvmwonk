  "scenarios": [
    {
      "name": "oaes-rlcc-bit",
      "note": "TP adds RLCC to OAES (bit 22) in Identify Controller; base must not have it. Also covers nested tables, elision rows, strike-edits (26:22 -> 26:23), and near-miss canaries.",
      "slices": [
        {
          "label": "TP-OAES",
          "doc": "docs/tp4176.xml",
          "xpath": "//table[contains(@caption, 'Identify Controller Data Structure, I/O Command Set Independent')]//row[contains(., 'OAES')]"
        },
        {
          "label": "BASE-OAES",
          "doc": "docs/base-2.3.xml",
          "xpath": "//table[contains(@caption, 'Identify Controller Data Structure, I/O Command Set Independent')]//row[contains(., 'OAES')]"
        }
      ],
      "statements": [
        {
          "id": "A1",
          "statement": "The TP-OAES slice contains a row describing the OAES field",
          "expect": true
        },
        {
          "id": "A2",
          "statement": "In TP-OAES, the OAES cell contains a nested table of bit definitions",
          "expect": true
        },
        {
          "id": "A3",
          "statement": "In TP-OAES, a bit named RLCC appears at bit 22, marked as newly added content",
          "expect": true
        },
        {
          "id": "A4",
          "statement": "In TP-OAES, the reserved bits directly above RLCC span 26:23",
          "expect": true
        },
        {
          "id": "A5",
          "statement": "In TP-OAES, the nested table contains a row consisting of a single ellipsis character",
          "expect": true
        },
        {
          "id": "A6",
          "statement": "In TP-OAES, a bit named DLPCN appears",
          "expect": false
        },
        {
          "id": "A7",
          "statement": "In BASE-OAES, a bit named DLPCN appears at bit 31",
          "expect": true
        },
        {
          "id": "A8",
          "statement": "In BASE-OAES, a bit named RLCC appears",
          "expect": false
        },
        {
          "id": "A9",
          "statement": "In BASE-OAES, the reserved range 26:22 appears",
          "expect": true
        },
        {
          "id": "A10",
          "statement": "In TP-OAES, the text '26:22' appears anywhere in the slice",
          "expect": false
        },
        {
          "id": "A11",
          "statement": "In TP-OAES, a bit named RLCCN appears",
          "expect": false
        },
        {
          "id": "A12",
          "statement": "In TP-OAES, RLCC appears at bit 23",
          "expect": false
        },
        {
          "id": "A13",
          "statement": "In TP-OAES, the reserved-bits description refers to Figure 409",
          "expect": true
        }
      ]
    },
